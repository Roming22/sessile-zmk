{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build firmware (pristine)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": ["-p"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Update west modules",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build.sh",
      "args": ["update"],
      "problemMatcher": []
    }
  ]
}
